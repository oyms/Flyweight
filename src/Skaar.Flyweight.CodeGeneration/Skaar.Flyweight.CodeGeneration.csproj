<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\CommonProps.targets" />
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <OutputItemType>Analyzer</OutputItemType>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Only the analyzer is packed, so there is nothing for a symbol package -->
        <IncludeSymbols>false</IncludeSymbols>
        <!-- Analyzer-only package: no lib folder and no dependencies (avoids NU5128) -->
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
        <IsGenerator>true</IsGenerator>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <RootNamespace>Skaar.Flyweight</RootNamespace>
    </PropertyGroup>
    
    <ItemGroup>
        <!-- Do not upgrade past the compiler in the oldest SDK consumers use (4.14 = SDK 9.0.3xx). A newer version makes the generator fail to load (CS9057). -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
        <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    </ItemGroup>
    
    <ItemGroup>
      <AdditionalFiles Include="AnalyzerReleases.Shipped.md"  />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
    
</Project>
